{
  "name": "kurone-ko-portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.34.1"
  },
  "pnpm": {
    "autoInstallPeers": false
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "start": "next start --hostname 127.0.0.1",
    "prebuild": "node scripts/verify-cinematic-assets.mjs",
    "build": "node scripts/build-static.mjs cloudflare",
    "build:cloudflare": "pnpm build",
    "build:github-pages": "pnpm prebuild && node scripts/build-static.mjs github-pages",
    "preview:static": "node scripts/serve-static.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --check .",
    "test": "vitest run",
    "e2e": "playwright test",
    "install:frozen": "pnpm install --frozen-lockfile --ignore-scripts"
  },
  "dependencies": {
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "24.10.2",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.9",
    "jsdom": "^29.1.1",
    "prettier": "3.8.4",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.8"
  }
}
